rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && request.auth.uid == resource.data.uid;
    }

    // User profile documents are keyed by uid
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Journal + project session entries, scoped by the uid field
    match /entries/{entryId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow read, delete: if ownsExisting();
      // uid is immutable once set
      allow update: if ownsExisting() && request.resource.data.uid == resource.data.uid;
    }

    // Projects, scoped by the uid field
    match /projects/{projectId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && request.resource.data.uid == resource.data.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
